# Kept out of cloud.model.earth, which the Worker serves straight from this
# folder (worker/wrangler.toml, [assets] directory = ".."). Same syntax as
# .gitignore. Everything not listed here is published.

# Never published, at any depth: dot-files and dot-folders (.git, .env, ...),
# node_modules, Rust target folders, private key files, and paths.yaml
# (automation's local config, which points to the env file).
.*
node_modules
target
*.pem
*.key
**/paths.yaml

# Source code a static site can't run (C# and Razor views in trade/IndustryDB),
# and .NET settings files, which can hold database connection strings.
*.cs
*.cshtml
appsettings*.json

# feed's React source: the feed pages load the built app from feed/dist, but
# feed/dist and feed's pages use the images and favicon in feed/src/assets.
/feed/src/*
!/feed/src/assets

# Servers, tooling and local config rather than pages.
/chat
/worker
/env
/bin
/docker
/package.json
/pnpm-lock.yaml
/vercel.json
/check-package-sync.js
/set-root-directory.js
/frontend-example.js
/AGENTS.md
/CLAUDE.md

# Too large for Workers assets (138,000+ files, some over the 25 MiB limit)
/community-data

# Python virtual environments, at any depth (e.g. data-pipeline's per-node env folders)
env/
venv/
.venv/

# auth is a Next.js app, so only its static export (auth/out, made by
# `pnpm build` in auth/) is published. The Worker serves it at /auth/.
/auth/*
!/auth/out

# automation holds local scripts and config: only its README page is published.
/automation/*
!/automation/index.html
!/automation/README.md
!/automation/manual.md

# tonic is the transcript webhook, run by the Worker at /ingest/*: only its
# README page (index.html renders README.md) and the docs it links are published.
/tonic/*
!/tonic/index.html
!/tonic/README.md
!/tonic/PLAN.md
!/tonic/AGENTS.md

# support holds agent setup notes: only the site config localsite reads is published.
/support/*
!/support/site
/support/site/*
!/support/site/config.yaml

# project/goals: download cache, full pipeline outputs and Worker source
# (served through /api/goals instead), and model run folders.
/project/goals/pipeline/cache
/project/goals/data/records
/project/goals/worker
/project/models/report*
/project/models/params

# engine's local voice bridge (node engine/server/local-bridge.mjs): the page script
# engine/claude-voice.js is published, its server isn't.
/engine/server

# veil/code (The Veil game) is published at /veil/code/, with its API run by the Worker at
# /veil/code/api/* (worker/src/veil.js). As on Vercel (veil/code/vercel.json), its server code,
# sealed story files and docs aren't: of lib/ the page loads only finale.js.
/veil/code/api
/veil/code/private
/veil/code/tests
/veil/code/package*.json
/veil/code/vercel.json
/veil/code/lib/*
!/veil/code/lib/finale.js
/veil/**/*.md
/veil/how-it-was-made
