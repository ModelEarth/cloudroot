# Commons Database
COMMONS_HOST=your-server.postgres.database.azure.com
COMMONS_PORT=5432
COMMONS_NAME=membercommons
COMMONS_USER=postgresadmin
COMMONS_PASSWORD=your_password
COMMONS_SSL_MODE=require

# Industry Database
EXIOBASE_HOST=your-server.postgres.database.azure.com
EXIOBASE_PORT=5432
EXIOBASE_NAME=industrydb
EXIOBASE_USER=postgresadmin
EXIOBASE_PASSWORD=your_password
EXIOBASE_SSL_MODE=require

# Industry Database provisioning (creates the per-year databases; needs CREATEDB privilege)
EXIOBASE_PROVISION_HOST=your-server.postgres.database.azure.com
EXIOBASE_PROVISION_PORT=5432
EXIOBASE_PROVISION_NAME=postgres
EXIOBASE_PROVISION_USER=postgresadmin
EXIOBASE_PROVISION_PASSWORD=your_password
EXIOBASE_PROVISION_SSL_MODE=require

# Locations Database
LOCATIONS_HOST=
LOCATIONS_PORT=5432
LOCATIONS_NAME=postgres
LOCATIONS_USER=postgres
LOCATIONS_PASSWORD=
LOCATIONS_SSL_MODE=require

# Core Database
CORE_HOST=
CORE_PORT=1433
CORE_NAME=CoreDatabase
CORE_USER=
CORE_PASSWORD=
CORE_SSL_MODE=require
CORE_PROVIDER=Microsoft.Data.SqlClient

# DBMonitor Database (Azure SQL Server, app's own Identity/profile/audit store)
DBMONITOR_HOST=
DBMONITOR_PORT=1433
DBMONITOR_NAME=DBMonitor
DBMONITOR_USER=
DBMONITOR_PASSWORD=

# Data Pipeline
BEA_API_KEY=get-key-at-apps.bea.gov/api/signup

# Agents
GEMINI_API_KEY=your-gemini-key # aistudio.google.com
ANTHROPIC_API_KEY=your-anthropic-key # Pay-as-you-go platform.claude.com → API Keys section.
CLAUDE_CODE_OAUTH_TOKEN=your-subscription-token # Run: claude setup-token
OPENAI_API_KEY=your-openai-key # Get key at platform.openai.com
XAI_API_KEY=your-xai-api-key # Get key at console.x.ai
XAI_API_URL=https://api.x.ai/v1 # X.ai API base URL (default: https://api.x.ai/v1)

# COMFY UI
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Team Rust API Server (team/ submodule)
SERVER_HOST=0.0.0.0 # Or 127.0.0.1 to block yourself from viewing from external domains.
SERVER_PORT=8081

# Shared .NET 10 Host (host/net/ serves the current webroot outside legacy /net and /core)
DOTNET_HOST=localhost
DOTNET_PORT=8010
DOTNET_ENVIRONMENT=Development
DOTNET_SITE_ROOT=.

# Arts Engine API Server (requests/ — X.ai image & text generation)
ARTS_ENGINE_HOST=localhost # Or 127.0.0.1 (which is IPv4) to avoid any IPv4/IPv6 ambiguity. Tokio's TcpListener::bind handles the ambiguity fine, and curl http://localhost:8082/api/health will follow the same resolution.
ARTS_ENGINE_PORT=8082

# Google Cloud Configuration
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_REGION=us-central1
GOOGLE_AR_REPO=containers
GOOGLE_SA_NAME=gha-deployer
GOOGLE_BILLING_ID=your_billing_id
GOOGLE_PROJECT_NUMBER=your_project_number
GOOGLE_SA_EMAIL=gha-deployer@your_google_project_id.iam.gserviceaccount.com
GOOGLE_SERVICE_KEY=

# Possibly optional
GOOGLE_ORG_ID=your_org_id

# Workload Identity Federation
GOOGLE_WIF_POOL_ID=github-pool
GOOGLE_WIF_PROVIDER_ID=github-oidc2
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=projects/your_project_number/locations/global/workloadIdentityPools/github-pool/providers/github-oidc2

# OIDC / GitHub
GITHUB_OWNER=ModelEarth
GITHUB_REPO=team
GITHUB_REF=refs/heads/main
# Also enable 'Notebook access' for a Secrets fields in the colab's left "key" nav.
GITHUB_REPORTS_TOKEN=

# View Project Lists
GITHUB_PERSONAL_ACCESS_TOKEN=

# Cloud Run
CLOUD_RUN_SERVICE=partner-tools-api

# WEBSITE
SITE_LOGO=

# Mapbox (community/js/common/dual-map.js, localsite/js/map.js, localsite/js/navigation.js)
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Sanity / Next.js site (sanity/ submodule, mounted by chat/server.mjs at /sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_viewer_token
NEXT_PUBLIC_BASE_URL=http://localhost:8888/sanity

# File Paths
PROJECTS_FILE_PATH=preferences/projects/DFC-ActiveProjects.xlsx

# DISCORD
DISCORD_BOT_TOKEN=

# Cognito Forms
COGNITO_FORMS_API=

# Debugging
DUMMY_SECRET=dummyvalue


# Better Auth (chat/lib/auth/instance.ts)
# Generate secret with: openssl rand -base64 32 — signs JWE session cookies
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
BETTER_AUTH_BASE_URL=http://localhost:3700
ALLOWED_ORIGINS=http://localhost:3700,http://localhost:8887,http://localhost:8888,http://localhost:8889

# OAuth2 Authentication Providers
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Discord OAuth (login) — separate from DISCORD_BOT_TOKEN above
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Session Configuration
SESSION_KEY=your-32-byte-session-key-here-change-in-production
FRONTEND_URL=http://localhost:8887/team
ALLOWED_REDIRECT_DOMAINS=localhost:8887,localhost:8888

# Require login to chat. When unset, login is required when not on localhost.
REQUIRE_AUTH=

# Chat Application (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_STORAGE_BUCKET=chat-attachments

# =====================================================
# Optional RAG / Vector Retrieval Configuration
# =====================================================
# Enables deterministic retrieval in /api/chat and optional retrieveContext tool.
# Keep RAG_ENABLED=true for retrieval; set false to disable.
RAG_ENABLED=true

# Pinecone index used by chat/ingestion/vector_db_sync.py
PINECONE_API_KEY=your-free-pinecone-api-key-from-app.pinecone.io
PINECONE_INDEX=repo-chunks

# Optional: index host (if omitted, resolved from Pinecone control API)
# Example: your-index-xxxx.svc.us-east-1-aws.pinecone.io
PINECONE_INDEX_HOST=

# Voyage API key used for query embeddings (voyage-code-3 by default)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-code-3

# Optional retrieval tuning
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.45
RAG_TIMEOUT_MS=8000
RAG_MAX_CONTEXT_CHARS=12000
RAG_PER_SNIPPET_CHARS=1800
RAG_NAMESPACE=

# Optional: set false to hide the dynamic retrieval tool from model toolset
RAG_TOOL_ENABLED=true

# NASA Earthdata credentials for NISAR data pipeline (scripts/fetch_nisar.py)
# Register free at https://urs.earthdata.nasa.gov
EARTHDATA_USER=your_earthdata_username
EARTHDATA_PASS=your_earthdata_password

# =====================================================
# Production Vercel — paste these into Vercel dashboard:
#   Project → Settings → [choose Production] → Environment Variables
#
# These three override the localhost values above. All other secrets
# (OAuth keys, Supabase, Postgres, API keys) are environment-agnostic
# and can be pasted as-is from the sections above.
# =====================================================
# BETTER_AUTH_SECRET=<generate separately: openssl rand -base64 32>
# BETTER_AUTH_BASE_URL=https://modelearth.vercel.app
# ALLOWED_ORIGINS=https://modelearth.vercel.app
