# `npm run dev` reads your env file (automation/paths.yaml env_file:), so this
# file is optional. Copy it to .dev.vars only to use other values locally.
# .dev.vars is git-ignored — never commit real keys.

# Agents
GEMINI_API_KEY=your-gemini-key # aistudio.google.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx # Pay-as-you-go platform.claude.com → API Keys section.
CLAUDE_CODE_OAUTH_TOKEN=your-subscription-token # Run: claude setup-token
OPENAI_API_KEY=sk-xxxxxxxx # Get key at platform.openai.com
XAI_API_KEY=your-xai-api-key # Get key at console.x.ai
XAI_API_URL=https://api.x.ai/v1 # X.ai API base URL (default: https://api.x.ai/v1)
ARTS_ENGINE_PASSPHRASE=your-arts-engine-passphrase # Typing this as the Gemini key in the Arts Engine uses GEMINI_API_KEY above. 12+ characters; a shorter one is ignored.
TEAM_PASSPHRASE=your-team-passphrase # Entering this in the voice widget (engine/claude-voice.js) lets it use ANTHROPIC_API_KEY. 12+ characters; until it's set, /api/claude-voice is off.

# Transcript intake (tonic/): POST http://localhost:3701/ingest/<WEBHOOK_SECRET>
WEBHOOK_SECRET=your-webhook-secret # Long random string: openssl rand -hex 32. Part of the TranscripTonic extension's webhook URL.
ARCHIVIST_TOKEN=your-archivist-token # A real token opens real PRs in ARCHIVIST_REPO, which runs its Claude workflow.
# Sign-in (see README.md, "Sign-in")
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# POSTGRES_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# CMS GitHub sign-in (README.md, "CMS sign-in"); callback http://localhost:3701/api/cms/callback
# CMS_GITHUB_CLIENT_ID=
# CMS_GITHUB_CLIENT_SECRET=
# BROWSER_ENCRYPTION_PRIVATE_KEY=  # PEM, for /api/public-key
